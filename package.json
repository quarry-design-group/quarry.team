{
  "name": "quarry.team",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Next-generation quarry.team marketing site. Astro + TypeScript monorepo on Cloudflare (Workers + D1).",
  "homepage": "https://quarry.team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarry-design-group/quarry.team.git"
  },
  "bugs": {
    "url": "https://github.com/quarry-design-group/quarry.team/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm --filter @quarry/ui build && pnpm --filter @quarry/web build",
    "build:web": "pnpm --filter @quarry/web build",
    "build:docs": "pnpm --filter @quarry/docs build",
    "deploy:docs": "pnpm --filter @quarry/docs build && pnpm --filter @quarry/docs deploy",
    "dev": "pnpm --filter @quarry/web dev",
    "dev:docs": "pnpm --filter @quarry/docs dev",
    "preview": "pnpm --filter @quarry/web preview",
    "lint": "eslint . --cache --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "tokens": "pnpm --filter @quarry/ui build",
    "images:check": "node scripts/images.mjs check",
    "images:fix": "node scripts/images.mjs fix",
    "audit:overrides": "node scripts/check-redundant-overrides.mjs",
    "sync": "pnpm --filter @quarry/web exec astro sync",
    "clean": "node scripts/clean.mjs",
    "prepare": "husky || true",
    "generate:og": "node scripts/generate-og.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro}": "eslint --fix",
    "*.{js,ts,mjs,cjs,astro,json,md,mdx,css,yml,yaml}": "prettier --write",
    "apps/web/src/{content,assets}/**/*.{png,jpg,jpeg,webp}": "node scripts/images.mjs fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@parcel/watcher",
      "workerd"
    ],
    "overrides": {
      "undici@>=7.18.0 <7.30.1": ">=7.30.1 <8"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    }
  }
}
