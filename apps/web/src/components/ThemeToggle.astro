---
/**
 * ThemeToggle — switches between light and dark, persisted to localStorage.
 * Default (no stored value) follows the OS via prefers-color-scheme (handled in
 * tokens.css). The no-FOUC init script lives in Base.astro <head>.
 */
---

<button
  class="theme-toggle inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-md border border-(--color-border) bg-transparent text-(--color-text) transition-colors duration-150 ease-out hover:border-(--color-border-strong) hover:bg-(--color-surface-2)"
  type="button"
  aria-label="Switch color theme"
  aria-pressed="false"
  title="Switch theme"
>
  <svg
    class="i sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="i moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.currentScript.previousElementSibling;
    if (!btn) return;
    const root = document.documentElement;
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    // The attribute is the live choice; storage only persists it. Storage
    // access throws when the browser blocks site data, and the toggle still
    // switches the theme for the page view.
    const effective = () => root.dataset.theme ?? (mq.matches ? 'dark' : 'light');
    const sync = () => btn.setAttribute('aria-pressed', String(effective() === 'dark'));
    btn.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* persistence unavailable */
      }
    });
    // Every instance (desktop bar, mobile menu) observes the document's theme,
    // so a switch from either one updates both.
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    // Without an explicit choice, follow OS changes live.
    mq.addEventListener('change', sync);
    sync();
  })();
</script>

<style>
  /* Residual: icon visibility tracks the data-theme attribute + system-pref
     hybrid, which Tailwind's `dark:` variant (prefers-color-scheme only)
     cannot express. */
  .i {
    display: none;
  }
  /* Light → show moon (click to go dark). Dark → show sun. */
  :global(:root) .moon {
    display: block;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
</style>
