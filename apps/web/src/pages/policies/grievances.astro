---
/**
 * /policies/grievances — the Grievances & Concerns policy with its intake form.
 *
 * Rendered ON DEMAND (the site's first server-rendered HTML route, ADR-0017)
 * so the mechanism works without JavaScript: every GET stamps a fresh signed
 * dwell-time token into the form; a POST is validated here and either
 * redirects to the confirmation (303, so a refresh never resubmits) or
 * re-renders the form with field-level errors and the visitor's text intact.
 * The policy prose itself is the `policies/grievances.mdx` entry — content
 * stays in the collection, the page owns the behaviour.
 *
 * Strict mode (production builds unless GRIEVANCE_STRICT=0): without the
 * signing key the page serves a 503 notice instead of a form that would sign
 * with a public dev key.
 */
export const prerender = false;

import { getEntry, render } from 'astro:content';
// Astro v6 removed Astro.locals.runtime.env on the Cloudflare adapter — worker
// bindings/secrets are imported from the runtime module instead.
import { env as workerEnv } from 'cloudflare:workers';
import Policy from '@/layouts/Policy.astro';
import GrievanceForm from '@/components/GrievanceForm.astro';
import {
  handleGrievance,
  hashIp,
  issueToken,
  parseForm,
  type FieldErrors,
  type FormValues,
  type GrievanceEnv,
  type Notice,
} from '@/lib/grievances';

const entry = await getEntry('policies', 'grievances');
if (!entry) throw new Error('policies/grievances.mdx is missing');
// The static template skips drafts; an on-demand page has to do it itself.
// The site's 404 is a static asset, so serve that page with a 404 status.
if (entry.data.draft) {
  const page = await fetch(new URL('/404', Astro.url)).catch(() => null);
  const body = page && page.status < 500 ? await page.text() : 'Not found';
  return new Response(body, {
    status: 404,
    headers: { 'content-type': 'text/html; charset=utf-8' },
  });
}
const { Content } = await render(entry);

const env = workerEnv as unknown as GrievanceEnv;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_GRIEVANCES_SITE_KEY ?? '';
const strict = import.meta.env.PROD && env.GRIEVANCE_STRICT !== '0';
// cf-connecting-ip is always set by the Cloudflare edge. Never touch Astro's
// `clientAddress` on this adapter — it is a getter that throws.
const ip = Astro.request.headers.get('cf-connecting-ip') ?? '';

let values: FormValues = {};
let errors: FieldErrors = {};
let notice: Notice | undefined;

if (strict && !env.WORKER_GRIEVANCE_SIGNING_KEY) {
  console.error('[grievances] WORKER_GRIEVANCE_SIGNING_KEY is not set; the form is offline');
  notice = { kind: 'unavailable', reason: 'offline' };
  Astro.response.status = 503;
} else if (Astro.request.method === 'POST') {
  try {
    values = parseForm(await Astro.request.formData());
  } catch {
    values = {};
  }
  try {
    const result = await handleGrievance(values, env, { ip, origin: Astro.url.origin, strict });
    if (result.kind === 'received') {
      // Quarantined or accepted, the visitor sees the same confirmation: we
      // never disclose whether a submission was filtered.
      return Astro.redirect(`/policies/grievances/received?ref=${result.ref}`, 303);
    }
    if (result.kind === 'invalid') {
      errors = result.errors;
      Astro.response.status = 422;
    } else if (result.kind === 'unavailable') {
      notice = result;
      Astro.response.status = 503;
    } else {
      notice = result;
      Astro.response.status = result.reason === 'rate_limited' ? 429 : 400;
      if (result.retryAfterSec) {
        Astro.response.headers.set('Retry-After', String(result.retryAfterSec));
      }
    }
  } catch (err) {
    // A D1 outage (or a migration not yet applied) must not cost the visitor
    // their text: re-render the form with everything they typed and a way out.
    console.error('[grievances] intake failed:', err);
    notice = { kind: 'unavailable', reason: 'outage' };
    Astro.response.status = 503;
  }
}

const token = await issueToken(
  env.WORKER_GRIEVANCE_SIGNING_KEY,
  await hashIp(env.WORKER_GRIEVANCE_SIGNING_KEY, ip),
);
---

<Policy entry={entry}>
  <Content />
  <section
    slot="after"
    class="container mt-12 max-w-(--measure)"
    id="raise"
    aria-labelledby="raise-heading"
  >
    <h2 id="raise-heading" class="text-3xl">
      Raise a concern
    </h2>
    <p class="mt-3 text-(--color-text-muted)">
      Anonymous submissions are welcome. Only the concern itself and the acknowledgment are
      required, plus an email address if you’d like us to follow up.
    </p>
    <div class="mt-8">
      <GrievanceForm
        values={values}
        errors={errors}
        token={token}
        siteKey={siteKey}
        notice={notice}
      />
    </div>
  </section>
</Policy>
