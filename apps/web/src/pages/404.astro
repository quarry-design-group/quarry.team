---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base title="Not found" noindex>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl">This page got quarried out.</h1>
      <p class="measure mt-4 text-lg text-(--color-text-muted)">
        The page you’re after isn’t here. It may have moved, or never existed. Let’s get you back to
        something solid.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/" size="lg">
          Back home
        </Button>
        <Button href="/work" variant="secondary" size="lg">
          See our work
        </Button>
      </div>
      <p class="mt-6 text-(--color-text-muted)">
        Or{' '}
        <a href="/search" data-astro-prefetch="false">
          search the site
        </a>{' '}
        for what you were after.
      </p>
    </div>
  </section>
</Base>
