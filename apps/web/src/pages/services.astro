---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import ToolsSection from '@/components/ToolsSection.astro';
import ProcessTimeline from '@/components/ProcessTimeline.astro';
import { stackLogos, workOsLogos, lifecycle } from '@/lib/site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const models: [string, string][] = [
  ['Project', 'A defined outcome, scoped and shipped. Fixed goals, senior execution.'],
  ['Embedded', 'We join your team and own a surface area end to end, like in-house.'],
  ['Fractional', 'High-level technical leadership and capacity without full-time overhead.'],
];
---

<Base
  title="Services: strategy, design, engineering & data"
  description="One senior team across the entire product lifecycle — engage by project, embedded, or fractional. No handoffs, no juniors, and outcomes you can measure."
>
  {/* The tools bands below are full-bleed siblings with their own padding-block
      (3–6rem each side), so the adjacent sections trim their own paddings to
      keep the page's vertical rhythm without double-padding the seams. */}
  <section class="pt-(--space-section) pb-16">
    <div class="container">
      <p class="eyebrow">Capabilities</p>
      <h1 class="mt-3 text-4xl">One team across the entire product lifecycle.</h1>
      <p class="measure mt-4 text-lg text-(--color-text-muted)">
        Strategy, humane design, engineering, and privacy-first data, carried by the same senior
        people from first sketch to production.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
        {services.map((s) => (
          /* scroll-mt: deep-link targets (case-page discipline chips) land
               clear of the header. */
          <article
            class="card scroll-mt-16 rounded-lg border border-(--color-border) bg-(--color-surface) p-8"
            id={s.id}
          >
            <h2 class="text-2xl">{s.data.title}</h2>
            <p class="mt-2 text-(--color-text-muted)">{s.data.summary}</p>
            <ul class="mt-4 pl-[1.1rem]">
              {s.data.capabilities.map((c) => (
                <li class="my-[0.35rem]">{c}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <!-- AI spotlight — the dark feature band linking to the /ai-services backbone page. -->
      <a
        class="surface-dark mt-4 grid gap-6 rounded-xl border border-(--color-ink-panel-border) bg-(--color-ink-panel) p-[clamp(1.5rem,1rem+3vw,3rem)] text-stone-25 no-underline transition-transform duration-250 ease-out hover:-translate-y-0.5 md:grid-cols-[1fr_auto] md:items-center"
        href="/ai-services"
      >
        <div>
          <p class="eyebrow text-blue-300">Capability spotlight</p>
          <h2 class="mt-3 text-3xl text-stone-25">AI development &amp; integration</h2>
          <p class="mt-3 max-w-[52ch] text-stone-300">
            AI as a product, AI as a feature: agents, retrieval, and LLM-powered workflows shipped
            with evals, guardrails, and privacy-first engineering.
          </p>
        </div>
        <span class="font-semibold whitespace-nowrap text-blue-300">Explore AI services →</span>
      </a>

      <h2 class="sub mt-24 text-3xl">How we engage</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {models.map(([t, d]) => (
          <div class="border-l-[3px] border-(--color-primary) pl-4">
            <h3 class="text-xl">{t}</h3>
            <p class="mt-2 text-(--color-text-muted)">{d}</p>
          </div>
        ))}
      </div>

      <p class="mt-8 text-(--color-text-muted)">
        Delivering in a regulated environment?{' '}
        <a class="font-semibold" href="/compliance">
          See the evidence — HIPAA, PCI DSS, GIPS, privacy regimes →
        </a>
      </p>
      <p class="mt-8 max-w-[60ch] text-(--color-text-muted)">
        However we engage, AI runs through the work as leverage, never as a substitute for senior
        judgment. <a href="/how-we-use-ai">See how we use AI</a>.
      </p>
    </div>
  </section>

  <ToolsSection
    heading="We speak the language of your work."
    intro="You shouldn't have to adopt our process to work with us. We meet your team inside the tools you already run on — your boards, your docs, your standups — so collaboration feels in-house from day one."
    items={workOsLogos}
  />

  <section class="pt-8 pb-16">
    <div class="container">
      <h2 class="sub text-3xl">What to expect</h2>
      <p class="mt-3 max-w-[60ch] text-(--color-text-muted)">
        The delivery lifecycle we’ve sharpened over a decade of shipping. This is how we work, end
        to end.
      </p>
      <ProcessTimeline phases={lifecycle} class="mt-8" />
    </div>
  </section>

  <ToolsSection
    heading="Deliberate about tools. Fluent across the stack."
    intro="A representative slice of what we design, build, and operate in production — chosen for the job, not the trend."
    items={stackLogos}
  />

  <section class="pt-8 pb-(--space-section)">
    <div class="container">
      <CtaBand
        title="Ready to put one senior team on it?"
        sub="Tell us what you’re working on. We reply within one business day."
      />
    </div>
  </section>
</Base>
