---
import Base from '@/layouts/Base.astro';
import Email from '@/components/Email.astro';
import SubmissionForm from '@/components/SubmissionForm.astro';
import { site } from '@/lib/site';
const calendlyUrl = 'https://calendly.com/work-with-quarry/quarry-meet-and-greet';

const altLabelCls = 'block font-mono text-xs uppercase tracking-[0.08em] text-(--color-text-muted)';
---

<Base
  title="Start a project: we reply in one business day"
  description="Tell us what you're building. A senior practitioner — not an account manager — reads every inquiry and replies within one business day. Or book a 30-minute call."
>
  <section class="section">
    <div class="container grid grid-cols-1 gap-12 min-[50rem]:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] min-[50rem]:items-start">
      <div class="max-w-[44ch]">
        <p class="eyebrow">Start a project</p>
        <h1 class="mt-3 text-4xl">Have something worth building well?</h1>
        <p class="mt-4 text-lg text-(--color-text-muted)">
          Tell us what you’re working on. We reply within one business day. Prefer email?
          <Email address={site.email} />.
        </p>
        <ul role="list" class="mt-8 grid list-none gap-3 p-0">
          <li>
            <span class={altLabelCls}>Email</span>
            <Email address={site.email} />
          </li>
          <li>
            <span class={altLabelCls}>Phone</span>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <span class={altLabelCls}>Where</span>
            {site.address.city}, {site.address.region} · Global
          </li>
        </ul>
        <p class="mt-6 border-t border-(--color-border) pt-4 text-sm text-(--color-text-muted)">
          <strong class="text-(--color-text)">Not sure yet?</strong> Start with a small proof of
          concept: tight scope, real output you keep either way. Mention “POC” in your message.
        </p>
        <p class="mt-4 text-sm text-(--color-text-muted)">
          <strong class="text-(--color-text)">Have a concern rather than a project?</strong> Anyone
          affected by our work can{' '}
          <a href="/policies/grievances" data-astro-prefetch="false">
            raise a concern
          </a>
          , anonymously if you prefer. It reaches a different inbox than this form.
        </p>
      </div>

      <SubmissionForm kind="contact" id="contact-form" class="w-full max-w-[540px]" />

      {/* Secondary "just want to talk?" offer — a full-width band beneath both
          columns (so it doesn't unbalance the form column). */}
      <aside class="col-span-full flex flex-col gap-4 rounded-lg border border-(--color-border) bg-(--color-surface) p-8 min-[50rem]:flex-row min-[50rem]:items-center min-[50rem]:justify-between min-[50rem]:gap-8">
        <div>
          <h2 class="text-lg">Just want to talk?</h2>
          <p class="mt-2 text-sm text-(--color-text-muted)">
            No brief required. Meet the team, ask anything, see if we’re a fit — 30 minutes, no
            pitch.
          </p>
        </div>
        <button
          type="button"
          class="mt-4 cursor-pointer rounded-md border border-(--color-border-strong) bg-transparent px-[1.1rem] py-[0.7rem] text-sm font-semibold text-(--color-text) transition-colors duration-150 ease-out hover:border-(--color-primary) hover:bg-(--color-surface-2) min-[50rem]:mt-0"
          data-calendly={calendlyUrl}
        >
          Book a 30-min meet &amp; greet
        </button>
      </aside>
    </div>
  </section>

  {/* The booking modal is ours, not Calendly's: a native <dialog> framing a
      lazy iframe to calendly.com. Their popup widget.js/widget.css require
      style-src/script-src 'unsafe-inline' (and offer no nonce/hash support),
      which the strict CSP forbids (ADR-0015) — but CSP governs this document,
      not the iframe's interior, so embedding their page directly keeps the
      booking flow with zero third-party code in ours. The iframe src is set on
      first open: no request leaves for Calendly until a visitor asks to book. */}
  {/* closedby="any" = native light dismiss where supported; the click handler
      below covers engines that still route backdrop clicks to the dialog.
      Styling: a strong scrim so the page clearly recedes, and a rounded,
      shadowed frame around Calendly's (white) booking page. m-auto restores
      the UA's dialog centering, which the global margin reset zeroes. */}
  <dialog
    class="mg-dialog m-auto h-[min(760px,calc(100dvh_-_var(--space-5)_*_2))] w-[min(1000px,calc(100vw_-_var(--space-5)_*_2))] overflow-hidden rounded-xl border-0 bg-(--color-surface) p-0 shadow-(--shadow-lg) backdrop:bg-[color-mix(in_oklab,var(--stone-950)_82%,transparent)] backdrop:backdrop-blur-[3px]"
    aria-label="Book a 30-minute meet & greet"
    closedby="any"
  >
    <button
      type="button"
      class="absolute top-2 right-2 z-[1] h-9 w-9 cursor-pointer rounded-md border-0 bg-[color-mix(in_oklab,var(--stone-950)_55%,transparent)] text-xl leading-none text-stone-0 hover:bg-[color-mix(in_oklab,var(--stone-950)_75%,transparent)]"
      data-close
      aria-label="Close booking dialog"
    >
      &times;
    </button>
    <iframe
      class="block h-full w-full border-0"
      title="Calendly — book a 30-minute meet & greet"
      data-src={calendlyUrl}
      loading="lazy"
    ></iframe>
  </dialog>

  <script is:inline>
    (() => {
      const dialog = document.querySelector('.mg-dialog');
      if (!dialog || !dialog.showModal) return;
      const frame = dialog.querySelector('iframe');
      document.querySelectorAll('[data-calendly]').forEach((b) =>
        b.addEventListener('click', () => {
          // Lazy: Calendly is contacted only on first open, and the URL is
          // stamped with the embed params their page expects when framed.
          if (frame && !frame.src) {
            const u = new URL(frame.dataset.src);
            u.searchParams.set('embed_domain', location.hostname);
            u.searchParams.set('embed_type', 'Popup');
            frame.src = u.href;
          }
          dialog.showModal();
        }),
      );
      dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      // Light-dismiss: a click on the backdrop (the dialog element itself,
      // never its children) closes, matching the old widget's behavior.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    })();
  </script>
</Base>
