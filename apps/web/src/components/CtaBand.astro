---
/**
 * CtaBand — the closing call-to-action band: blue panel, display title,
 * optional sub line, primary CTA. One component so every marketing page
 * closes the same way (home, /services, /team, /ai-services, /compliance,
 * /how-we-use-ai).
 */
import Button from '@/components/Button.astro';
import { primaryCta } from '@/lib/site';

interface Props {
  title: string;
  sub?: string;
  label?: string;
  href?: string;
}
const { title, sub, label = primaryCta.label, href = primaryCta.href } = Astro.props;
---

<div class="grid items-center gap-6 rounded-xl bg-(--color-cta) p-[clamp(2rem,1rem+4vw,4rem)] text-stone-0 md:grid-cols-[1fr_auto]">
  <div>
    <h2 class="max-w-[18ch] text-3xl text-stone-0">{title}</h2>
    {sub && <p class="mt-3 text-blue-100">{sub}</p>}
  </div>
  <Button href={href} variant="secondary" size="lg">
    {label}
  </Button>
</div>
