---
/**
 * Compliance — a capability statement about delivering in highly regulated
 * environments. Renders the frameworks we design and deliver to as a grid of
 * cards. Data-driven from site.ts so it stays a single source of truth.
 */
import { compliance } from '@/lib/site';
interface Props {
  class?: string;
  /** Link out to the /compliance evidence page (off when rendered ON that page). */
  cta?: boolean;
  /**
   * Replace the capability lede. The /compliance page passes a one-line
   * framing caption instead — its evidence ledger has already made these
   * claims in full just above the grid.
   */
  lede?: string;
}
const defaultLede =
  'We’ve shipped HIPAA-compliant infrastructure for mental-health care, hardened commerce against card-testing and skimming, and engineered data platforms where provenance and privacy aren’t optional. We design to the controls from day one — not as a retrofit.';
const { class: cls, cta = true, lede = defaultLede } = Astro.props;
---

<section class:list={[cls]}>
  <div class="container">
    <p class="eyebrow">Delivering in regulated environments</p>
    <h2 class="mt-3 max-w-[22ch] text-3xl">
      When the rules are non-negotiable, that’s our comfort zone.
    </h2>
    <p class="measure mt-4 text-lg text-(--color-text-muted)">{lede}</p>

    <ul
      class="mx-0 mt-12 mb-0 grid list-none grid-cols-1 gap-3 p-0 min-[35rem]:grid-cols-2 min-[57.5rem]:grid-cols-3"
      role="list"
    >
      {compliance.map((f) => (
        <li class="rounded-md border border-(--color-border) bg-(--color-surface) p-4 transition-[border-color,transform] duration-150 ease-out hover:-translate-y-0.5 hover:border-(--color-border-strong)">
          <span class="block font-display text-lg font-semibold">{f.abbr}</span>
          <span class="mt-1 block font-mono text-xs tracking-[0.04em] text-(--color-primary)">
            {f.name}
          </span>
          <span class="mt-2 block text-sm text-(--color-text-muted)">{f.blurb}</span>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-(--color-text-muted)">
      …and the rest of the alphabet soup. Tell us your regime — we’ll meet it.
    </p>
    {cta && (
      <a class="mt-4 inline-block font-semibold" href="/compliance">
        See the evidence — how we deliver in regulated environments →
      </a>
    )}
  </div>
</section>
