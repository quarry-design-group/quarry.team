---
/**
 * /work/discipline/<discipline> — a prerendered view of the case library
 * scoped to one discipline: its own title, description and CollectionPage
 * structured data, the shared filter bar and grid (WorkGrid), and a route to
 * the practice that covers it on /services. One page per discipline with at
 * least one published case; the discipline tags on each case link here.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { site } from '@/lib/site';
import {
  byCaseOrder,
  disciplineHref,
  disciplineLabels,
  disciplineOrder,
  disciplineViews,
  isPublished,
  type Discipline,
} from '@/lib/work';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).filter(isPublished);
  return disciplineOrder
    .filter((d) => cases.some((c) => c.data.disciplines.includes(d)))
    .map((d) => ({ params: { discipline: d } }));
}

const discipline = Astro.params.discipline as Discipline;
const view = disciplineViews[discipline];
const label = disciplineLabels[discipline];
const service = (await getCollection('services')).find((s) => s.id === view.serviceId)?.data;
const cases = (await getCollection('cases'))
  .filter(isPublished)
  .filter((c) => c.data.disciplines.includes(discipline))
  .sort(byCaseOrder);
// The first card's hero is this page's LCP element. Preload it with the exact
// srcset/sizes CaseCard's <Image> renders, so the fetch starts with the HTML
// and requests the same derivatives.
const lcpHero = cases[0]?.data.hero
  ? await getImage({ src: cases[0].data.hero, widths: [400, 800] })
  : undefined;

const pageUrl = `${site.url}${disciplineHref(discipline)}`;
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: view.title,
  description: view.description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', url: site.url, name: site.name },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cases.length,
    itemListElement: cases.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.data.title,
      url: `${site.url}/work/${c.id}`,
    })),
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work` },
    { '@type': 'ListItem', position: 3, name: label, item: pageUrl },
  ],
};
---

<Base
  title={view.title}
  description={view.description}
  image="/og/work.png"
  imageAlt="Outcomes with receipts. Selected Quarry case studies, 2016–present."
  jsonLd={[collectionLd, breadcrumbLd]}
>
  {lcpHero && (
    <link
      slot="head"
      rel="preload"
      as="image"
      imagesrcset={lcpHero.srcSet.attribute}
      imagesizes="(min-width:700px) 50vw, 100vw"
      fetchpriority="high"
    />
  )}
  <section class="section">
    <div class="container">
      <p class="eyebrow">
        <a href="/work" class="text-inherit underline underline-offset-2">
          Work
        </a>{' '}
        / {label}
      </p>
      <h1 class="mt-3 text-4xl">{view.heading}</h1>
      <p class="measure mt-4 text-lg text-(--color-text-muted)">
        {view.description}
        {service && (
          <>
            {' '}
            <a href={`/services#${view.serviceId}`} class="whitespace-nowrap">
              About our {service.title} practice →
            </a>
          </>
        )}
      </p>

      <WorkGrid active={discipline} />
    </div>
  </section>
</Base>
