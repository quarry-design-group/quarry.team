# ---- Web (apps/web) — build-time ----
SITE_URL=https://quarry.team
# Public Turnstile site keys, baked into the form markup at build time: the
# managed widget for contact/careers, the invisible widget for the grievance form.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_TURNSTILE_GRIEVANCES_SITE_KEY=

# ---- Worker runtime secrets (GitHub environment secrets, shipped by each deploy; never committed) ----
# The D1 form_submissions database is bound as `DB` (see apps/web/wrangler.toml), not an env var.
WORKER_TURNSTILE_SECRET=
WORKER_FORM_SUBMISSIONS_IP_HASH_KEY=
WORKER_RESEND_API_KEY=
WORKER_FORM_SUBMISSIONS_NOTIFY_TO=hello@quarry.team
WORKER_FORM_SUBMISSIONS_NOTIFY_FROM="Quarry Site <noreply@quarry.team>"
WORKER_FORM_SUBMISSIONS_WEBHOOK_URL=
# Grievance intake (ADR-0017). Non-secret ids live in apps/web/wrangler.toml [vars].
WORKER_TURNSTILE_GRIEVANCES_SECRET=
WORKER_GRIEVANCE_SIGNING_KEY=
WORKER_NOTION_TOKEN=
WORKER_GRIEVANCE_NOTIFY_TO=concerns@quarry.team
# The backup's OWN inbox (never the shared alias): the only recipient for concerns that involve the owner.
WORKER_GRIEVANCE_NOTIFY_BACKUP_TO=

# ---- Deploy / Infra (GitHub Actions secrets, not committed) ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
