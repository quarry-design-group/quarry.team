---
/**
 * Email — renders an address and its `mailto:` link as HTML character
 * references, so scrapers harvesting raw HTML see only entities (e.g. `&#104;…`)
 * rather than a plain `name@domain`. Browsers decode entities natively, so it's
 * zero-JS and fully accessible. Defense-in-depth alongside Cloudflare's
 * email-address obfuscation (Scrape Shield). See SECURITY.md.
 */
interface Props {
  /** The email address (first-party, build-time only). */
  address: string;
  /** Optional visible label; defaults to the address itself. */
  text?: string;
  class?: string;
}
const { address, text, class: cls } = Astro.props;
const entity = (s: string) => [...s].map((c) => `&#${c.charCodeAt(0)};`).join('');
const href = entity(`mailto:${address}`);
const label = entity(text ?? address);
const clsAttr = cls ? ` class="${cls}"` : '';
const html = `<a href="${href}"${clsAttr}>${label}</a>`;
---

<Fragment set:html={html} />
