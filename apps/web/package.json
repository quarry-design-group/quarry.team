{
  "name": "@quarry/web",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quarry-design-group/quarry.team.git",
    "directory": "apps/web"
  },
  "type": "module",
  "description": "Quarry next-gen marketing site (Astro).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm postbuild",
    "postbuild": "node scripts/inject-csp-hashes.mjs && node -e \"fs.cpSync('migrations','dist/server/migrations',{recursive:true})\"",
    "preview": "sirv dist/client --port 4321 --host --quiet",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply marketing-site-form-submissions --local -c dist/server/wrangler.json",
    "preview:worker": "pnpm db:migrate:local && wrangler dev -c dist/server/wrangler.json --port 8788 --show-interactive-dev-session=false --var GRIEVANCE_STRICT:0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quarry/ui": "workspace:*",
    "astro": "^7.4.11",
    "cobe": "^2.0.1",
    "minisearch": "^7.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.8",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24",
    "fontaine": "^1.0.3",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
